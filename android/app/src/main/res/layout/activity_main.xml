<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#181C24">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tether"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/ipInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="PC IP Address (e.g. 192.168.1.50)"
        android:textColorHint="#8A94A6"
        android:textColor="#FFFFFF"
        android:background="#222733"
        android:padding="12dp"
        android:inputType="text"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/codeInput"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="6-Digit Pairing Code"
        android:textColorHint="#8A94A6"
        android:textColor="#FFFFFF"
        android:background="#222733"
        android:padding="12dp"
        android:inputType="number"
        android:maxLength="6"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Connect"
        android:textSize="18sp"
        android:backgroundTint="#1F8A4C"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Not connected"
        android:textSize="16sp"
        android:textColor="#A0AFBE"
        android:layout_marginTop="32dp"
        android:gravity="center" />

</LinearLayout>
